project('devterm', 'c', version: '0.1.0', default_options: ['c_std=c11', 'warning_level=2'])

gtk = dependency('gtk4', version: '>=4.10')
vte = dependency('vte-2.91-gtk4', version: '>=0.70')
json = dependency('json-glib-1.0', version: '>=1.6')
gio = dependency('gio-2.0')
pcre = dependency('libpcre2-8')
secret = dependency('libsecret-1', version: '>=0.20')
util = meson.get_compiler('c').find_library('util')

src = files('src/commands.c')
terminal_src = files('src/pane.c', 'src/split-layout.c', 'src/sessions.c')
executable('devterm', ['src/main.c', 'src/text-export.c', 'src/sessions-ui.c', 'src/credentials.c', terminal_src, src], dependencies: [gtk, vte, json, gio, pcre, secret], install: true)
executable('devterm-connect', ['src/connect-helper.c', 'src/sessions.c', 'src/login.c'], dependencies: [gtk, json, gio, util], install: true)
test_exe = executable('test-commands', ['tests/test-commands.c', src], dependencies: [json, gio])
test('commands', test_exe)
layout_test = executable('test-layout', ['tests/test-layout.c', terminal_src], dependencies: [gtk, vte, gio, pcre, json])
test('layout', layout_test, env: ['SHELL=/bin/sh', 'G_DEBUG=fatal-criticals'], timeout: 30)
search_test = executable('test-search', ['tests/test-search.c', 'src/pane.c', 'src/sessions.c'], dependencies: [gtk, vte, gio, pcre, json])
test('search', search_test, env: ['SHELL=/bin/sh', 'G_DEBUG=fatal-criticals'], timeout: 30)
export_test = executable('test-export', ['tests/test-export.c', 'src/text-export.c'], dependencies: [gio])
test('export', export_test, env: ['G_DEBUG=fatal-criticals', 'GIO_USE_VFS=local'], timeout: 30)
contents_test = executable('test-contents', ['tests/test-contents.c', 'src/pane.c', 'src/text-export.c', 'src/sessions.c'], dependencies: [gtk, vte, gio, pcre, json])
# Clipboard/PRIMARY ownership is shared with search tests on the same display.
test('contents', contents_test, env: ['SHELL=/bin/sh', 'G_DEBUG=fatal-criticals'], is_parallel: false, timeout: 30)
sessions_test = executable('test-sessions', ['tests/test-sessions.c', 'src/sessions.c', 'src/login.c'], dependencies: [json, gio])
test('sessions', sessions_test, env: ['G_DEBUG=fatal-criticals'], timeout: 30)
session_ui_test = executable('test-session-ui', ['tests/test-session-ui.c', 'src/sessions-ui.c', 'src/credentials.c', 'src/sessions.c'], dependencies: [gtk, json, gio, secret])
test('session-ui', find_program('dbus-run-session'), args: ['--', session_ui_test], env: ['G_DEBUG=fatal-criticals'], is_parallel: false, timeout: 45)
test('connections', find_program('python3'), args: [files('tests/test-connections.py'), meson.current_build_dir() / 'devterm-connect'], is_parallel: false, timeout: 90)
